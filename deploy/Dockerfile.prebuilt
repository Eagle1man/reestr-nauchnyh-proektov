# Образ приложения без этапа сборки интерфейса.
#
# Отличие от deploy/Dockerfile: там интерфейс собирается внутри образа
# (нужен node и доступ к npm). Здесь берётся уже собранный frontend/dist из
# архива поставки. Причина: на машине в вузе сборка интерфейса — лишний риск
# (нет node, нет доступа к npm), а результат сборки одинаковый.
#
# Сборка: docker compose -f deploy/docker-compose.local.yml build

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=Europe/Moscow

# Пакеты через apt здесь НЕ ставятся намеренно. Во-первых, они не нужны:
# зона Europe/Moscow доступна через zoneinfo, а проверка живости делается
# тем же Python. Во-вторых, на старых движках (Docker 19.03 + overlay2)
# распаковка .deb падает с «lzma error: Cannot allocate memory» — образ
# просто не собирается. Меньше слоёв — меньше причин для отказа.

# Приложение работает не от root: каталоги данных и копий принадлежат
# непривилегированному пользователю.
RUN useradd --system --create-home --uid 10001 registry \
 && mkdir -p /app/data /app/backups /app/storage \
 && chown -R registry:registry /app

WORKDIR /app

COPY backend/requirements.txt backend/requirements.txt
# --progress-bar off: индикатор загрузки поднимает отдельный поток, а на
# ограничении числа процессов в контейнере это падает с «can't start new
# thread». С выключенным индикатором установка идёт одним потоком.
RUN pip install --no-cache-dir --progress-bar off -r backend/requirements.txt

COPY backend/ /app/backend/
COPY --chown=registry:registry frontend/dist/ /app/frontend/dist/
COPY .env.example /app/.env.example

RUN chown -R registry:registry /app

USER registry

ENV DATABASE_PATH=/app/data/registry.db \
    BACKUP_DIR=/app/backups

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status==200 else 1)"

# --workers 2 совпадает с боевой службой systemd. WAL выставляется в
# ExecStartPre только в systemd, поэтому в контейнере его выставляет сам
# код при первом соединении (с повтором при блокировке).
CMD ["python", "-m", "uvicorn", "app.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "2", \
     "--app-dir", "/app/backend", \
     "--proxy-headers", "--forwarded-allow-ips", "*", \
     "--no-server-header"]
