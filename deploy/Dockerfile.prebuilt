# Образ приложения без этапа сборки интерфейса.
#
# Отличие от deploy/Dockerfile: там интерфейс собирается внутри образа
# (нужен node и доступ к npm). Здесь берётся уже собранный frontend/dist из
# архива поставки. Причина: на машине в вузе сборка интерфейса — лишний риск
# (нет node, нет доступа к npm), а результат сборки одинаковый.
#
# Сборка: docker compose -f deploy/docker-compose.local.yml build

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=Europe/Moscow

# tzdata обязателен: без него Python не знает зону Europe/Moscow, а время
# в интерфейсе и журнале должно быть московским (п.10.2 п.2).
RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata curl \
 && rm -rf /var/lib/apt/lists/*

# Приложение работает не от root: каталоги данных и копий принадлежат
# непривилегированному пользователю.
RUN useradd --system --create-home --uid 10001 registry \
 && mkdir -p /app/data /app/backups /app/storage \
 && chown -R registry:registry /app

WORKDIR /app

COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend/ /app/backend/
COPY --chown=registry:registry frontend/dist/ /app/frontend/dist/
COPY .env.example /app/.env.example

RUN chown -R registry:registry /app

USER registry

ENV DATABASE_PATH=/app/data/registry.db \
    BACKUP_DIR=/app/backups

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

# --workers 2 совпадает с боевой службой systemd. WAL выставляется в
# ExecStartPre только в systemd, поэтому в контейнере его выставляет сам
# код при первом соединении (с повтором при блокировке).
CMD ["python", "-m", "uvicorn", "app.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "2", \
     "--app-dir", "/app/backend", \
     "--proxy-headers", "--forwarded-allow-ips", "*", \
     "--no-server-header"]
